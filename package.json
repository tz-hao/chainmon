{
  "name": "chainmon",
  "version": "0.1.0",
  "private": true,
  "description": "ChainMon — a Pokemon-like Web3 monster collecting game (Web MVP)",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "cd apps/web && next dev",
    "build": "cd apps/web && next build",
    "start": "cd apps/web && next start",
    "lint": "cd apps/web && next lint",
    "typecheck": "cd apps/web && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:contracts": "cd contracts && npx hardhat test",
    "contracts:compile": "cd contracts && npx hardhat compile",
    "contracts:abi": "cd contracts && npx hardhat run scripts/export-abi.ts",
    "contracts:deploy:local": "cd contracts && npx hardhat run scripts/deploy.ts",
    "contracts:deploy:monad": "cd contracts && npx hardhat run scripts/deploy.ts --network monadTestnet",
    "contracts:grant-roles": "cd contracts && npx hardhat run scripts/grant-roles.ts",
    "contracts:verify:monad": "cd contracts && npx hardhat verify --network monadTestnet",
    "monad:preflight": "tsx scripts/monad-preflight.ts",
    "audit:state": "tsx scripts/audit-state.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:env:rpc": "tsx scripts/validate-env.ts --check-rpc",
    "e2e:browser": "tsx scripts/browser-e2e.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@chainmon/game-engine": "file:packages/game-engine",
    "@chainmon/monster-data": "file:packages/monster-data",
    "@chainmon/shared": "file:packages/shared",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.101.4",
    "next": "^14.2.15",
    "phaser": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.55.17",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
