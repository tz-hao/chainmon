# ChainMon — environment template (committed, NO real secrets).
# Copy to `.env` for local development:  Copy-Item .env.example .env

# PostgreSQL connection used by the Prisma CLI (db push / migrate / studio).
# The web app (apps/web) reads its own .env — see apps/web/.env.example.
DATABASE_URL=

# Data mode: prisma (required in production) | memory (development/test only).
CHAINMON_DATA_MODE=prisma

# Exact database name required by the guarded, manual playtest reset command.
# Leave blank unless the operator has confirmed a specific target database.
CHAINMON_PLAYTEST_DATABASE_NAME=

# --- Contracts deployment (used by contracts/ scripts) ---
# Monad Testnet (primary public testnet target, chainId 10143).
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=

# Historical: Base Sepolia (earlier planned target).
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
