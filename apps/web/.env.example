# Next.js runtime environment (apps/web).
# Copy to `.env.local` for local development (Next.js loads .env.local automatically).
# The Prisma CLI reads the root-level `.env` — see chainmon/.env.example.
# NEVER commit .env.local — it contains real private keys.

# PostgreSQL (real DB; use 127.0.0.1 not localhost on Windows + Docker)
DATABASE_URL=

# Data mode: prisma (real PostgreSQL, fail-closed) | memory (Demo Mode, dev only)
CHAINMON_DATA_MODE=prisma

# --- Web3: Monad Testnet (primary public testnet, chainId 10143) ---
CHAINMON_CHAIN_ID=10143
CHAINMON_RPC_URL=https://testnet-rpc.monad.xyz
CHAINMON_MONSTER_NFT_ADDRESS=
CHAINMON_MONSTER_MARKETPLACE_ADDRESS=
# Backend operator key (MINTER + EVOLVER roles on Monad Testnet).
# SERVER-ONLY — never in browser. May equal MONAD_DEPLOYER_PRIVATE_KEY for a demo.
CHAINMON_MINTER_PRIVATE_KEY=
# HMAC secret for the HttpOnly verified-wallet session (32+ random bytes).
# SERVER-ONLY — required for production; do not expose with NEXT_PUBLIC_.
CHAINMON_SESSION_SECRET=

# --- Public (client-side) ---
NEXT_PUBLIC_CHAINMON_CHAIN_ID=10143
NEXT_PUBLIC_CHAINMON_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONSTER_NFT_ADDRESS=
NEXT_PUBLIC_MONSTER_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contracts deployment key (Monad) — same file may hold it for the demo ---
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=
